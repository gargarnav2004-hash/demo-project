ANTHROPIC_API_KEY=

# Optional: Claude calls allowed per day across all users (default 300).
AI_DAILY_CALL_LIMIT=

# Supabase project settings -> API. Use the service_role key (server-only,
# never exposed to the client) — not the anon/public key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for the /admin question + rubric editor.
ADMIN_PASSWORD=

# Your own Clerk user id (Clerk dashboard -> Users). Only this account can open
# /admin/eval, and nobody can if it's blank.
ADMIN_CLERK_USER_ID=

# Clerk (clerk.com) -> your application -> API Keys. Both keys must come from
# the SAME application. Users must sign in to practice.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostHog -> Settings -> Project -> General. The host is the ingest URL, e.g.
# https://us.i.posthog.com. Analytics stays off until both are set.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional: a feedback form link for the "Give feedback" links. Defaults to an
# email to the contact address.
NEXT_PUBLIC_FEEDBACK_URL=

# Optional: your public site address, e.g. https://example.com, for links in
# share previews. Defaults to the Vercel production URL.
NEXT_PUBLIC_SITE_URL=
